# --- API ---
NODE_ENV=development
PORT=3001
# SQLite file (relative to apps/api). Postgres swap is documented in the README.
DATABASE_URL=file:./local.db
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# 32+ byte secrets. Generate: openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
OTP_PEPPER=change-me-otp-pepper-at-least-32-bytes-long

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# SMTP (Mailpit locally: no auth, no TLS). Leave empty to log OTPs to stdout.
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="Speech to Text <no-reply@stt.local>"

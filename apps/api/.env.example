# --- API ---
NODE_ENV=development
PORT=3001
APP_NAME=Speech to Text
# PostgreSQL only. Local Docker Postgres:
DATABASE_URL=postgresql://stt:stt@127.0.0.1:5432/stt
DATABASE_SSL=false
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_MAX_LIFETIME_SECONDS=600
# Production Supabase session pooler (replace password and region):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true
# Admin URL used by the test harness to create a disposable database per process:
TEST_DATABASE_URL=postgresql://stt:stt@127.0.0.1:5432/postgres
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# 32+ byte secrets. Generate: openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
OTP_PEPPER=change-me-otp-pepper-at-least-32-bytes-long
ARGON2_PARALLELISM=1
ARGON2_ITERATIONS=2
ARGON2_MEMORY_KIB=19456
ARGON2_HASH_LENGTH=32

# --- Audio storage ---
# local: files under STORAGE_DIR (default) | supabase: Supabase Storage REST API
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Keep this at or below your bucket's file-size limit. The Supabase bucket used
# by this project is private with a 15 MiB limit.
MAX_AUDIO_BYTES=15728640
# Required for STORAGE_DRIVER=supabase. Create a PRIVATE bucket, e.g. "transcripts".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=transcripts

# --- Speech to text ---
# groq: hosted Whisper over HTTPS | gemini: Gemini 2.5 Flash | whistle: self-deployed Whistle
STT_PROVIDER=groq
# Leave empty to auto-detect. Use "en" or "hi" to pin a language.
STT_LANGUAGE=
# Optional prior text hint for Whisper. Kept empty by default to prevent hallucination.
STT_PROMPT=
# Server-only. Never expose this as NEXT_PUBLIC_*.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_GROQ_MODEL=whisper-large-v3
GROQ_TIMEOUT_MS=20000

GEMINI_API_KEY=
STT_GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000

WHISTLE_URL=https://whistle.heureux.tech/transcribe
WHISTLE_API_KEY=
WHISTLE_TIMEOUT_MS=20000

STT_STEP_MS=1500
STT_MAX_WINDOW_MS=3000
STT_MIN_WINDOW_MS=800
STT_SILENCE_RMS=220
STT_MAX_BUFFER_MS=60000
STT_CONTEXT_CHARS=200
STT_ERROR_COOLDOWN_MS=5000
STT_MAX_FINAL_COOLDOWN_WAIT_MS=10000

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# SMTP (Mailpit locally: no auth, no TLS). Leave empty to log OTPs to stdout.
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM="Speech to Text <no-reply@stt.local>"

    "fastify": "^5.4.0",
    "hash-wasm": "^4.12.0",
    "jose": "^6.0.0",
    "nodemailer": "^7.0.0",
    "postgres": "^3.4.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^7.0.0",
    "@types/ws": "^8.18.2",

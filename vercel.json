{
  "regions": ["syd1"],
  "services": {
    "web": {
      "root": "apps/web/"
    },
    "api": {
      "root": "apps/api/",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/transcripts",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/transcripts/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
